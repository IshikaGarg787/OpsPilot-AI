# Copy to .env and replace both values with long random strings.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
MODEL_API_TOKEN=replace-with-a-different-random-secret-at-least-32-characters
# Optional: set this to a shared MongoDB URI to use the same users and tickets across devices.
# Leave blank to use the local MongoDB container and its persistent Docker volume.
MONGODB_URI=
