FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
COPY ml/requirements-delay-risk.txt ./ml/requirements-delay-risk.txt
RUN pip install --no-cache-dir -r ml/requirements-delay-risk.txt
COPY ml ./ml
COPY artifacts-delay_risk_model ./artifacts-delay_risk_model
EXPOSE 8001
CMD ["uvicorn", "ml.delay_risk_service:app", "--host", "0.0.0.0", "--port", "8001"]
